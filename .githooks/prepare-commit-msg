#!/usr/bin/env bash
# Git prepare-commit-msg hook. Turned on with the other hooks: git config core.hooksPath .githooks
# On a plain `git commit` in a terminal, asks two questions:
#   "What type of commit is this?": feat, fix, refactor, docs, or chore (a conventional commit),
#     suggesting one from which files are staged (suggest_type), which is quick but less informed
#     than /commit-message's, which reads the diff (see "Commit messages" in docs/TECH_STACK.md).
#     A number or the type's name chooses it, Enter takes the suggestion, and s (or Enter with
#     no suggestion) skips both questions, leaving git's usual message. Anything else asks again.
#   "What type of commit message do you want to add?": 1 succinct, 2 highlights, 3 verbose, or
#     4 (the default) write your own, which starts the message with the type (e.g. "feat: ").
#     A number or the first word of the choice ("highlights") chooses it; anything else asks again.
# For 1 to 3, Claude writes it from the staged changes with the /commit-message skill
# (.claude/skills/commit-message/SKILL.md). Either way the editor opens next, so you can review
# and change it; an empty message cancels the commit, as usual.
# Skipped, leaving git's usual message, for `git commit -m` or `-F`, merges, squashes, amends,
# nothing staged, and when there's no terminal to ask in (such as VS Code's commit box), or no
# `claude` command.

MSG_FILE="$1"
SOURCE="$2"

# Only a plain commit, whose message comes from the editor.
[ -z "$SOURCE" ] || exit 0
# Only when there's a terminal to ask in.
( : </dev/tty ) 2>/dev/null || exit 0
command -v claude >/dev/null 2>&1 || exit 0
# Nothing staged, nothing to describe.
git diff --cached --quiet && exit 0

# A type to suggest, from the staged files' paths alone: only docs → docs; only tooling (Claude
# Code settings, hooks, and skills, git hooks, scripts, config and dependencies), maybe with docs
# → chore; a new file in the app → feat. Otherwise none, since telling a fix from a refactor
# takes reading the diff.
suggest_type() {
    local files added
    files=$(git diff --cached --name-only)
    added=$(git diff --cached --name-only --diff-filter=A)
    local docs='^(docs/|README\.md$|CLAUDE\.md$)'
    local tooling='^(\.claude/|\.githooks/|scripts/|\.gitignore$|backend/(requirements\.txt|pyproject\.toml|alembic\.ini)$|frontend/(package(-lock)?\.json|tsconfig[^/]*\.json|vite\.config\.ts|\.oxlintrc\.json)$)'
    if ! grep -qvE "$docs" <<<"$files"; then
        echo docs
    elif ! grep -vE "$docs" <<<"$files" | grep -qvE "$tooling"; then
        echo chore
    elif grep -qE '^(backend/app|frontend/src)/' <<<"$added"; then
        echo feat
    fi
}
suggested=$(suggest_type)
TYPES=(feat fix refactor docs chore)
DESCRIPTIONS=(
    "a new feature or behavior"
    "a bug fix"
    "code restructured without changing what it does"
    "documentation only"
    "tooling, config, dependencies, or hooks"
)

{
    echo
    echo "What type of commit is this?"
    for i in "${!TYPES[@]}"; do
        mark=""
        [ "${TYPES[$i]}" = "$suggested" ] && mark=" (suggested)"
        echo "  $((i + 1))) ${TYPES[$i]}: ${DESCRIPTIONS[$i]}$mark"
    done
} >/dev/tty
type=""
while [ -z "$type" ]; do
    if [ -n "$suggested" ]; then
        printf "Choose 1-5 [Enter for %s, s to skip]: " "$suggested" >/dev/tty
    else
        printf "Choose 1-5 [Enter to skip]: " >/dev/tty
    fi
    read -r choice </dev/tty
    choice=$(tr '[:upper:]' '[:lower:]' <<<"$choice")
    case "$choice" in
        [1-5]) type=${TYPES[$((choice - 1))]} ;;
        feat | fix | refactor | docs | chore) type=$choice ;;
        "") [ -n "$suggested" ] && type=$suggested || exit 0 ;;
        s | skip) exit 0 ;;
        *) echo "Type a number from 1 to 5, a type's name, or s to skip." >/dev/tty ;;
    esac
done

{
    echo
    echo "What type of commit message do you want to add?"
    echo "  1) Succinct: one line"
    echo "  2) Highlights: a subject, plus one line per significant change"
    echo "  3) Verbose: a subject, plus every meaningful change"
    echo "  4) Write my own"
} >/dev/tty
level=""
while [ -z "$level" ]; do
    printf "Choose 1-4 [4]: " >/dev/tty
    read -r choice </dev/tty
    choice=$(tr '[:upper:]' '[:lower:]' <<<"$choice")
    case "$choice" in
        1 | succinct) level=succinct ;;
        2 | highlights) level=highlights ;;
        3 | verbose) level=verbose ;;
        "" | 4 | write | "write my own")
            # Yours to write, starting with the type.
            { printf '%s: \n' "$type"; cat "$MSG_FILE"; } >"$MSG_FILE.tmp" && mv "$MSG_FILE.tmp" "$MSG_FILE"
            exit 0
            ;;
        *) echo "Type a number from 1 to 4." >/dev/tty ;;
    esac
done

echo "Claude is writing a $level $type message from the staged changes..." >/dev/tty
ROOT="$(git rev-parse --show-toplevel)"
# Only read-only git commands are allowed, so it can't change anything.
message=$(cd "$ROOT" && claude -p "/commit-message $type $level --raw" \
    --allowedTools "Bash(git status:*)" "Bash(git diff:*)" "Bash(git log:*)" "Read" 2>/dev/null \
    | sed -e '/^```/d' -e '/^Co-Authored-By:/d' \
    | sed -E -n '/^\*{0,2}(feat|fix|refactor|docs|chore):/,$p' \
    | sed -E '1s/\*\*//g')  # Only the message: no code block, trailer, or narration above it.
if [ -z "$message" ]; then
    echo "Couldn't write one, so it's yours to write." >/dev/tty
    message="$type: "
fi

# The message goes above git's own comments (the list of files, and so on).
{ printf '%s\n' "$message"; cat "$MSG_FILE"; } >"$MSG_FILE.tmp" && mv "$MSG_FILE.tmp" "$MSG_FILE"
