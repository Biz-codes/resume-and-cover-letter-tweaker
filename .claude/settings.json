{
  "permissions": {
    "allow": [
      "Bash(git mv *)",
      "Skill(claude-api)",
      "Skill(claude-api:*)",
      "Read(//Users/biz_codes/.nvm/versions/node/**)",
      "Read(//opt/homebrew/bin/**)",
      "Bash(python3 scripts/check_demo_data.py)",
      "Bash(dscl . -read /Users/biz_codes UserShell)",
      "Read(//Users/biz_codes/**)",
      "Bash(zsh -lic 'which python3; python3 --version; which node; node --version; which pg_isready')",
      "Bash(bash -lc 'which python3; python3 --version; which node; which pg_isready')",
      "Edit(/.claude/skills/check/**)",
      "Bash(PATH=/Users/biz_codes/.nvm/versions/node/v24.16.0/bin:__TRACKED_VAR__ node_modules/.bin/vitest run src/documents/ProposalCards src/documents/ChatPanel src/documents/DocumentPage)",
      "Bash(python3 -)",
      "Bash(PATH=/Users/biz_codes/.nvm/versions/node/v24.16.0/bin:__TRACKED_VAR__ node_modules/.bin/oxlint)",
      "Bash(PATH=/Users/biz_codes/.nvm/versions/node/v24.16.0/bin:__TRACKED_VAR__ node_modules/.bin/oxlint src/documents/ChatPanel/ChatPanel.tsx)",
      "Bash(PATH=/Users/biz_codes/.nvm/versions/node/v24.16.0/bin:__TRACKED_VAR__ node_modules/.bin/vitest run src/shared/components/HeaderFields)",
      "Bash(xargs -I{} sed -n '{}p' docs/FRONTEND_CHECKS.md)",
      "Bash(PATH=/Users/biz_codes/.nvm/versions/node/v24.16.0/bin:__TRACKED_VAR__ node_modules/.bin/vitest run src/documents/DraftTree)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_after_edit.py\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y_review.py\" record"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y_review.py\" reviewed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/a11y_review.py\" remind"
          }
        ]
      }
    ]
  }
}
