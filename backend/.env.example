# Copy this file to .env in the same folder and fill in the values. .env is gitignored.

# Local Homebrew Postgres 18 on port 5433 (psycopg driver). It connects as your Mac user
# with no password, so these work as is.
DATABASE_URL=postgresql+psycopg://localhost:5433/resume_tweaker

# Separate database the tests run against. Tests rebuild its schema on every run.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5433/resume_tweaker_test

# From console.anthropic.com. Needed from phase 5 (job postings and AI).
ANTHROPIC_API_KEY=sk-ant-...
